<Window x:Class="ToolHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ToolHelper.ViewModels"
        Title="{Binding WindowTitle}" Height="768" Width="1200"
        Icon="/ToolHelper;component/Resources/logo/logo.png"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.FontFamily="Microsoft YaHei"
        TextElement.FontSize="14"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 顶部标题和搜索 -->
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                    <TextBlock Text="&#x1F528; 极早期调试辅助工具" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>

                <!-- 分类列表 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredCategories}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="True" Padding="0"
                                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="12,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                VerticalAlignment="Center" Width="20" Height="20"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Tools.Count, StringFormat='({0})'}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Opacity="0.6" FontSize="12" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ListBox ItemsSource="{Binding Tools}"
                                             BorderThickness="0" Padding="0">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                                <Setter Property="Padding" Value="20,6,12,6" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="FontSize" Value="13" />
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ToolItem_MouseDown" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                                             Fill="{DynamicResource PrimaryHueLightBrush}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentView}" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
